# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/pulse_entertainment

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=pulse_entertainment_super_secret_key_change_in_production_32char

# Google OAuth Credentials
# Lấy từ Google Cloud Console (APIs & Services > Credentials > OAuth 2.0 Client IDs)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Google AdSense Publisher ID (sau khi được duyệt)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
